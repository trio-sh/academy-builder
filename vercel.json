{
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/v1/chat/completions", "destination": "/api/chat/completions" },
    { "source": "/chat/completions", "destination": "/api/chat/completions" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
