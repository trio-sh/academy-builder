-- Day 1 event registry, envelope, hash chain and strict ingestion (T3A-DEV-DAY1-001 v@@DICT_VERSION@@, step 11.1.3).
-- GENERATED: do not edit by hand. Regenerate with: python3 tools/day1/generate_event_migration.py   (verify with --check)
-- Source: docs/day1/package/@@DICT_FILE@@
-- Source sha256: @@DICT_SHA@@
--
-- Additive. The existing t3a_event_log is kept and extended so the nine live pathway functions that write to it
-- keep working. New code writes through t3a_ingest_event (strict). Old writers pass through a tolerant path until
-- each pathway is migrated, then t3a_event_config.ingest_mode is set to 'strict'.
--
-- Defaults chosen where the package is silent (recorded in docs/day1/conflict-register.md):
--   * stream = one (resource_type, resource_id) pair; the first event of a stream chains to a genesis value of 64 zeros;
--   * integrity_hash = sha256 over event_id | event_name | occurred_at (UTC, milliseconds) | actor_id | payload text;
--   * reference existence is enforced for real events only; synthetic_test and demonstration events skip it.

-- ---------------------------------------------------------------- configuration
create table if not exists public.t3a_event_config (
  key        text primary key,
  value      text not null,
  updated_at timestamptz not null default now()
);
insert into public.t3a_event_config (key, value) values
  ('ingest_mode', 'legacy_tolerant'),
  ('dictionary_version', '@@DICT_VERSION@@'),
  ('schema_version', '1.0'),
  ('max_payload_bytes', '4096'),
  ('genesis_hash', repeat('0', 64))
on conflict (key) do nothing;

-- ---------------------------------------------------------------- registries
create table if not exists public.t3a_event_registry (
  dictionary_version text not null references public.t3a_field_registry_version(dictionary_version),
  event_name         text not null check (event_name ~ '^[a-z][a-z0-9_]*\.[a-z][a-z0-9_]*$'),
  event_category     text not null,
  status             text not null check (status in ('ACTIVE','DORMANT','SOCKET')),
  trigger_text       text,
  required_payload   text[] not null,
  optional_payload   text[] not null,
  conditional        jsonb not null default '[]'::jsonb,
  payload_schema     jsonb not null,
  worst_case_payload_bytes integer,
  primary key (dictionary_version, event_name),
  check (jsonb_typeof(payload_schema) = 'object' and jsonb_typeof(conditional) = 'array')
);

create table if not exists public.t3a_event_name_alias (
  alias              text primary key,
  dictionary_version text not null,
  event_name         text not null,
  confidence         text not null check (confidence in ('package','direct','provisional')),
  note               text,
  foreign key (dictionary_version, event_name) references public.t3a_event_registry(dictionary_version, event_name)
);

create table if not exists public.t3a_event_reference_rule (
  payload_key text primary key,
  ref_table   text not null,
  ref_column  text not null,
  note        text
);

create table if not exists public.t3a_event_idempotency (
  idempotency_key  text primary key,
  payload_sha256   char(64) not null check (payload_sha256 ~ '^[0-9a-f]{64}$'),
  source_system    text not null,
  first_accepted_at timestamptz not null default now(),
  event_id         uuid not null unique
);

create table if not exists public.t3a_event_rejection (
  rejection_id    uuid primary key default gen_random_uuid(),
  attempted_name  text,
  resolved_name   text,
  reason_code     text not null,
  detail          text,
  payload_sha256  char(64),
  actor_ref       text,
  record_property text,
  source_system   text,
  occurred_at     timestamptz,
  rejected_at     timestamptz not null default now()
);

create table if not exists public.t3a_quality_event (
  quality_event_id uuid primary key default gen_random_uuid(),
  severity         text not null check (severity in ('critical','major','minor')),
  kind             text not null,
  detail           jsonb not null default '{}'::jsonb,
  event_id         uuid,
  created_at       timestamptz not null default now()
);

create or replace function public.t3a_event_registry_append_only() returns trigger
language plpgsql as $$
begin
  raise exception 'T3A_APPEND_ONLY: this event store is insert only';
end $$;

do $$
declare t text;
begin
  foreach t in array array['t3a_event_registry','t3a_event_rejection','t3a_quality_event'] loop
    execute format('drop trigger if exists t3a_append_only on public.%I', t);
    execute format('create trigger t3a_append_only before update or delete on public.%I for each row execute function public.t3a_event_registry_append_only()', t);
  end loop;
  foreach t in array array['t3a_event_config','t3a_event_registry','t3a_event_name_alias','t3a_event_reference_rule','t3a_event_idempotency','t3a_event_rejection','t3a_quality_event'] loop
    execute format('alter table public.%I enable row level security', t);
    execute format('revoke all on public.%I from anon, authenticated', t);
  end loop;
end $$;

