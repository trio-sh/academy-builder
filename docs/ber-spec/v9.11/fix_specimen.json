  "controlled_texts": {
    "T-PURPOSE-001": "A record documenting selected conduct observed in defined workplace situations. The participant controls whether this report is available to approved employers through The 3rd Academy and may withdraw future availability at any time.",
    "T-VERIFCAP-001": "Verify the authoritative status before relying on this copy.",
    "T-SCOPE-001": [
      "Scope and limits.",
      "This report contains recorded conduct for represented dimensions only. It is not a complete account of the participant's workplace conduct. Dimensions not represented are listed below; their absence is not a conclusion about the participant. This report records selected conduct in defined situations and does not state whether a participant should be selected, placed, promoted, preferred, or otherwise chosen for an opportunity."
    ],
    "T-FRAME-REC": "Recorded in each of the {context_count} Stage contexts identified for this entry:",
    "T-LIMIT-001": "This statement is limited to the recorded contexts. It is not a statement about character, general tendency, suitability, or future behavior.",
    "T-ILLUS-001": "Illustrative only. An approved Recorded Conduct Entry renders here.",
    "T-DIFF-SEP": "These observations remain separate. Neither is preferred, averaged, or used to broaden the recurrence statement.",
    "T-DIFFSHOWN-001": [
      "How differences are shown.",
      "The recurring clause stays in Observed conduct. The adjacent Differences across settings field preserves context specific variation. A difference does not erase recurrence of a separate clause, and recurrence does not erase the difference."
    ],
    "T-AVAIL-001": "Made available to approved employers through the participant controlled process. Evidence current until: {d}. Verification reference: {r}.",
    "T-STUB-001": "No recorded conduct for these dimensions is carried here. Their absence is not a conclusion about the participant.",
    "T-EVNOTE-001": "Stage 1 written situations are administered through an AI system. A Stage 1 observation enters the evidence record only after authorized human confirmation. Source linked statements remain subject to participant review, correction, amendment and evidence currency controls.",
    "T-USE-001": [
      "Permitted use:",
      "This report provides supplementary behavioral evidence from defined workplace situations. It may be considered as one source of information in an employer's independent employment judgment. It does not recommend or determine an employment decision and must not be used as the sole basis for adverse employment action. It is not a prediction of job performance, retention or probation outcome."
    ],
    "T-DISC-001": [
      "Disclosure limits:",
      "This report was made available at the participant's discretion and covers only the evidence window stated above. Withdrawal ends availability for subsequent access through The 3rd Academy; it does not recall a copy already read. Earlier or later reports may exist; this page is not the complete observation history."
    ],
    "T-INTEG-001": [
